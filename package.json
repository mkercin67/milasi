  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/buildGlyphPaths.mjs && tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "bench": "npm run build && node scripts/bench.mjs",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "test:i18n": "node scripts/test_i18n_dom.mjs",
    "typecheck": "tsc --noEmit",
    "licenses": "node scripts/checkLicenses.mjs",
    "spdx": "node scripts/checkSpdx.mjs --fix",
    "spdx:check": "node scripts/checkSpdx.mjs",
    "shortcuts": "node scripts/generateShortcuts.mjs",
    "shortcuts:check": "node scripts/generateShortcuts.mjs --check",
    "reviewpack": "node scripts/generateReviewPack.mjs",
    "check": "tsc --noEmit && node scripts/checkImports.mjs && node scripts/checkLicenses.mjs && node scripts/checkSpdx.mjs && node scripts/generateShortcuts.mjs --check && eslint src/ && npx knip && npm test && npm run build"
  },
  "dependencies": {
    "immer": "^10.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tone": "^15.0.4"
  },
  "devDependencies": {
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "knip": "^6.45.1",
    "opentype.js": "^2.0.0",
    "playwright": "^1.65.1",
